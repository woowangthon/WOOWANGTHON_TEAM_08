# 상담 메모 모델 선택 (서버 전용): 1=Gemini (기본값), 2=Groq
LLM_PROVIDER=1

# 두 채팅 말투를 모두 사용하려면 아래 API 키 두 개가 필요합니다.
# 실제 키는 .env.local 또는 배포 환경의 서버 환경변수에 설정하세요.
# Gemini: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Auth (로그인/회원가입)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 정부24 공공서비스 API 인증키 (서버 전용)
GOV24_SERVICE_KEY=

# 네이버 지도 (상담기관 찾기 지도)
# 네이버 클라우드 콘솔 > Maps 애플리케이션의 Client ID. 사이트 주소(localhost:3000 등)를 등록해야 해요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Notion 저장 기능 (서버 전용, 실제 값은 .env.local에만 넣으세요)
# Notion 개발자 포털 > 연결 > OAuth 연결의 클라이언트 ID / 시크릿
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# 선택: 포털에 등록한 리디렉션 URI와 달라질 때만 지정 (기본값: 현재 사이트 주소 + /notion/callback)
NOTION_REDIRECT_URI=
